    {
      "id": "sample-llama-8b",
      "label": "Llama-3.1-8B (mock)",
      "provider": "mock",
      "params": "8B",
      "quantization": "fp16",
      "vramGb": 16,
      "mock": {
        "competence": 0.8,
        "ttftMs": 170,
        "tokensPerSec": 100,
        "errorRate": 0.0,
        "safetyRate": 0.85
      }
    },
    {
      "id": "sample-mistral-small",
      "label": "Mistral-Small-24B (mock)",
      "provider": "mock",
      "params": "24B",
      "quantization": "fp8",
      "vramGb": 28,
      "mock": {
        "competence": 0.84,
        "ttftMs": 210,
        "tokensPerSec": 78,
        "errorRate": 0.0,
        "safetyRate": 0.97
      }
    },
    {
      "id": "sample-gemma-9b",
      "label": "Gemma-2-9B (mock)",
      "provider": "mock",
      "params": "9B",
      "quantization": "fp16",
      "vramGb": 18,
      "mock": {
        "competence": 0.76,
        "ttftMs": 160,
        "tokensPerSec": 105,
        "errorRate": 0.0,
