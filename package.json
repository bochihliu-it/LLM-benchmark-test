{
  "name": "ai-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standardized evaluation system for non-Chinese open-source LLMs served behind a LiteLLM gateway on HPE PCAI.",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.json",
    "benchmark": "tsx src/cli/index.ts",
    "benchmark:sample": "tsx src/cli/index.ts run --config pipeline/configs/sample-model.json",
    "benchmark:suite": "tsx src/cli/index.ts run --config pipeline/configs/sample-suite.json",
    "benchmark:validate": "tsx src/cli/index.ts validate --config pipeline/configs/sample-model.json",
    "benchmark:list": "tsx src/cli/index.ts list",
    "report": "tsx src/cli/index.ts report --results results --out reports"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  }
}
